{
  "name": "goat-downhill",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "build": "esbuild src/game.js --bundle --minify --format=esm --outfile=dist/game.js",
    "build:server": "esbuild server/main.mjs --bundle --platform=node --format=esm --minify --banner:js=\"import {createRequire} from 'node:module';const require=createRequire(import.meta.url);\" --outfile=server/index.mjs",
    "start": "python3 -m http.server 4173 --directory dist",
    "start:server": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": { "cannon-es": "0.20.0", "three": "^0.180.0", "ws": "8.22.0" },
  "devDependencies": { "esbuild": "^0.25.10" }
}
